# Google Sheet (gviz fallback)
SHEET_ID=

# Apps Script Web App
APPS_SCRIPT_URL=
NEXT_PUBLIC_APPS_SCRIPT_URL=

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret to protect /api/sync (any random string). Set the same value on Vercel.
SYNC_SECRET=

# Portal login — Resend (https://resend.com) sends one-time codes + invites
RESEND_API_KEY=
RESEND_FROM_EMAIL="All In Capital <team@allincapital.vc>"

# Random 32+ char string used to sign session cookies (e.g. `openssl rand -base64 32`)
SESSION_SECRET=

# Seed emails shown in the invite panel (login itself is capped to @allincapital.vc)
ALLOWED_EMAILS=aarjav@allincapital.vc,kb@allincapital.vc,kushal@allincapital.vc

# Public URL of the deployed portal, used in invite email links
NEXT_PUBLIC_APP_URL=https://tofu-aic.vercel.app

# Attio CRM — automatic writes are limited to the separate Inbound list
# (New / Passes / Human Review). Deal Flow is manual-only through the
# "Add to Attio" button (any Deal Flow column + Owner).
ATTIO_API_KEY=
ATTIO_INBOUND_LIST_SLUG=inbound
ATTIO_DEAL_FLOW_LIST_SLUG=vc_deal_flow
ATTIO_DEAL_FLOW_STAGE_ATTR=deal_stage

# Rating module — rules + OpenAI on production. Jev (TypeSafe) is localhost-only
# (`next dev`); it never appears on tofu-aic.vercel.app.
# Docs: https://docs.typesafe.ai/introduction
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# PDF deck agent — only for 5★ or 1★ deals with a deckLink (founders + raise + short summary).
# Off by default. Set to 1 after running supabase/migrate-deck-summary.sql.
ENABLE_DECK_SUMMARY=0
DECK_SUMMARY_BATCH=30
DECK_MAX_BYTES=15728640

# LinkedIn enrich via Bright Data Datasets API (profiles by URL).
# Inbound: store work + college for brand-new Sheet rows when
# ENABLE_LINKEDIN_BRIGHTDATA=1.
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_LINKEDIN_DATASET_ID=gd_l1viktl72bvl7bjuj0
ENABLE_LINKEDIN_BRIGHTDATA=0
# Sourcing: stored LinkedIn photos overlay on GET. Missing previews fill in
# the background (no Fetch button). Set ENABLE_SOURCING_LINKEDIN=0 to skip.
# ENABLE_SOURCING_LINKEDIN=1
# LinkedIn scrapes ONLY brand-new inbound Sheet rows when the dashboard polls
# (reconcileNewDeals). No poll bulk, no cron backlog, no force re-scrape.

# Call-invite emails (bucket dropdown). From must be a verified @allincapital.vc
# address — team@ is already verified. Body still signs off as Kushal.
# Reply-To defaults to response@allincapital.vc.
RESEND_FROM_CALL="All In Capital <team@allincapital.vc>"
RESEND_REPLY_TO=response@allincapital.vc
KUSHAL_REPLY_TO=response@allincapital.vc

# Per-person calendar links used in founder call-invite emails.
# Code has defaults matching the team sheet; env overrides win.
CALENDLY_AARJAV=https://calendar.app.google/EsVwwxnN45VjrK9v6
CALENDLY_SIDDHARTH=https://calendar.app.google/McgHTCPJ1sXfoppz9
SIDDHARTH_EMAIL=siddharth@allincapital.vc
CALENDLY_KUSHAL=https://cal.com/kushal-bhagia/30min
CALENDLY_SIMRAN=https://calendar.app.google/7zQLitFE6cQcgCof7
CALENDLY_DISHA=https://calendar.app.google/bVUfu2nidbD6JMe16
CALENDLY_ADITYA1=https://calendar.app.google/6qCjzHUsZYK24V7G7
CALENDLY_ADITYA2=https://calendly.com/adityasingh2-allincapital/30min

# Deal sourcing — live for every signed-in @allincapital.vc account (local + prod).
# Completely separate from inbound SHEET_ID / Founders.
# Create via apps-script/sourcing/Code.gs → setupSourcingWorkbook on the other
# Google account. Never point these at the inbound Founders workbook.
SOURCING_SHEET_ID=
SOURCING_APPS_SCRIPT_URL=
NEXT_PUBLIC_SOURCING_APPS_SCRIPT_URL=
SOURCING_APPS_SCRIPT_TOKEN=

# Tracxn (platform.tracxn.com → API & Developer Tools → Production → API Token).
# Sourcing cards look up each company by website domain (1 credit per hit,
# misses are free) and cache the profile + funding rounds in Supabase
# sourcing_tracxn. Set ENABLE_SOURCING_TRACXN=0 to pause lookups.
TRACXN_API_KEY=
# ENABLE_SOURCING_TRACXN=1

